# BarrioBot — variables de entorno
#
# Ninguna de estas es obligatoria: si no configuras ninguna, el agente sigue
# funcionando con un generador de mensajes local (plantillas), así que la demo
# nunca se rompe por falta de API key.
#
# Si configuras alguna, el agente usa un LLM real para redactar las
# notificaciones, recomendaciones y respuestas del chat. Se revisa primero
# ANTHROPIC_API_KEY, luego OPENAI_API_KEY y, si ninguna existe, GEMINI_API_KEY.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
