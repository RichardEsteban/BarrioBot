# BarrioBot — variables de entorno
#
# Ninguna de estas es obligatoria: si no configuras ninguna, el agente sigue
# funcionando con un generador de mensajes local (plantillas), así que la demo
# nunca se rompe por falta de API key.
#
# Si configuras una de las dos, el agente usa un LLM real para redactar las
# notificaciones y recomendaciones. Se revisa primero ANTHROPIC_API_KEY y,
# si no existe, OPENAI_API_KEY.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
